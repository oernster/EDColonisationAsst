#!/usr/bin/env bash
set -euo pipefail

# Git pre-commit hook for EDColonisationAsst
#
# This hook automatically:
#   1. Formats staged Python files with black.
#   2. Re-stages any reformatted files.
#   3. Runs the full gated suite and blocks the commit if it fails.
#
# To enable this hook, run once in the repo root:
#   git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

# ---------------------------------------------------------------------------
# 0. Resolve one interpreter for every step
# ---------------------------------------------------------------------------
#
# The tooling (black, flake8, ruff, pytest) lives in the repository-root venv/.
# An earlier version of this hook preferred backend/.venv, which has never
# existed here, so it always fell through to whatever was on PATH and the
# interpreter depended on which shell the commit was made from. backend/venv/
# exists but carries none of the tooling, so it is deliberately not a candidate.

PY=()
if [ -x "venv/Scripts/python.exe" ]; then
  PY=("venv/Scripts/python.exe")
elif [ -x "venv/bin/python" ]; then
  PY=("venv/bin/python")
elif command -v python3 >/dev/null 2>&1; then
  PY=("python3")
elif command -v python >/dev/null 2>&1; then
  PY=("python")
else
  echo "[pre-commit] ERROR: no Python interpreter found."
  echo "[pre-commit]        Create the root venv/ and install requirements-dev."
  exit 1
fi

if ! "${PY[@]}" -c "import pytest, black, flake8, ruff" >/dev/null 2>&1; then
  echo "[pre-commit] ERROR: ${PY[*]} is missing pytest, black, flake8 or ruff."
  echo "[pre-commit]        Install backend/requirements-dev.txt into it."
  exit 1
fi

echo "[pre-commit] Using interpreter: ${PY[*]}"

# ---------------------------------------------------------------------------
# 1. Format staged Python files with black
# ---------------------------------------------------------------------------

echo "[pre-commit] Checking for staged Python files to format with black..."

# List staged Python files (respecting git add -p, etc.), skipping any that the
# commit deletes: black cannot format a path that is no longer on disk.
CHANGED_PY_FILES="$(git diff --cached --name-only --diff-filter=d -- '*.py' || true)"

if [ -z "${CHANGED_PY_FILES}" ]; then
  echo "[pre-commit] No staged Python files; skipping black."
else
  echo "[pre-commit] Running black on staged Python files:"
  # shellcheck disable=SC2086
  printf '  %s\n' ${CHANGED_PY_FILES}

  # Use NUL-separated xargs to handle spaces safely.
  # shellcheck disable=SC2086
  printf '%s\0' ${CHANGED_PY_FILES} | xargs -0 "${PY[@]}" -m black

  # Re-stage any files that black reformatted.
  # shellcheck disable=SC2086
  printf '%s\0' ${CHANGED_PY_FILES} | xargs -0 git add

  echo "[pre-commit] black formatting complete; updated files re-staged."
fi

# ---------------------------------------------------------------------------
# 2. Lint the surface that is already clean
# ---------------------------------------------------------------------------
#
# backend/src joined this list once its sweep finished; it now passes both
# linters with zero findings; the point of gating it here is that it stays
# that way. frontend/ has no linter wired at all and is still outside.
#
# ruff runs twice because the two halves resolve different configuration:
# backend/src is linted against backend/pyproject.toml, named explicitly so the
# result does not depend on the working directory, while installer/,
# installer_main.py and tests/ sit above that file with no configuration to
# discover, which --isolated states outright rather than leaving to wherever
# ruff stops walking. flake8 reads .flake8 at the root for all of them and
# needs no line-length flag.

LINT_PATHS=(installer installer_main.py tests)

echo "[pre-commit] Linting: ${LINT_PATHS[*]} backend/src"

"${PY[@]}" -m ruff check --isolated "${LINT_PATHS[@]}"
"${PY[@]}" -m ruff check --config backend/pyproject.toml backend/src
"${PY[@]}" -m flake8 "${LINT_PATHS[@]}" backend/src

echo "[pre-commit] Linters clean."

# ---------------------------------------------------------------------------
# 3. Run the full gated suite and block the commit on failure
# ---------------------------------------------------------------------------
#
# A bare `pytest` from the repository root picks up pytest.ini, which runs both
# suites (backend/tests and tests) under the 100% coverage gate with asyncio_mode
# set. The previous `-c backend/pytest.ini backend/tests` ran the backend half
# only, so a commit breaking the installer suite (or dropping the setup
# program's Qt-free packages below the gate) still passed the hook.

echo "[pre-commit] Running the full gated suite (pytest)..."

"${PY[@]}" -m pytest -q

echo "[pre-commit] Gated suite passed."
echo "[pre-commit] All checks passed; proceeding with commit."
exit 0
